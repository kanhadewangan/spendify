{
  "expo": {
    "name": "Spendify",
    "slug": "spendify",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Spendify",
      "themeColor": "#0A0A0F",
      "backgroundColor": "#0A0A0F"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F5F5FA",
          "dark": {
            "backgroundColor": "#0A0A0F"
          }
        }
      ],
      "expo-web-browser"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.astroshrine.spendify"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#72F4A3"
      },
      "package": "in.astroshrine.spendify"
    },
    "scheme": "spendify"
  }
}
