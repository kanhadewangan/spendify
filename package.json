    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.19",
    "expo-router": "~56.2.22",
    "expo-sharing": "~56.0.27",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "lucide-react-native": "^1.61.0",
